[Unit]
Description=Sample Flask application (EC2 start utility test app)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=sampleapp
Group=sampleapp
WorkingDirectory=/opt/sample-app
EnvironmentFile=/etc/sample-app/sample-app.env
ExecStart=/opt/sample-app/venv/bin/gunicorn --bind 0.0.0.0:${APP_PORT} --workers 2 --access-logfile - app:app
# Allows binding to ports below 1024 (e.g. 80) without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
